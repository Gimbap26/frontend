# 이 파일을 복사해서 .env 로 저장하세요
#   cp .env.example .env
# .env 는 깃에 올라가지 않습니다.

# 배포 URL: https://gimbap26.khoon.net/api/v1
# 로컬 URL: http://localhost:8080/api/v1
VITE_API_BASE_URL=

# 개발용 사용자 ID (Bearer 토큰 붙기 전까지 X-User-Id 헤더로 사용)
VITE_DEV_USER_ID=1

# 조회 기준월 (형식: YYYY-MM).
# 비워두면 오늘이 속한 달을 자동으로 사용합니다. (자산·거래·일정 화면이 같은 달을 봅니다)
# 백엔드 시드 데이터가 특정 달에만 있어 그 달을 봐야 할 때만 값을 채우세요. (예: 2026-09)
VITE_BASE_MONTH=
