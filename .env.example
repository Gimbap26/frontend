# 이 파일을 복사해서 .env 로 저장하세요
#   cp .env.example .env
# .env 는 깃에 올라가지 않습니다.

# 백엔드 API base URL (예: http://localhost:8080/api/v1)
# 비워두면 목데이터 모드로 동작합니다.
VITE_API_BASE_URL=

# 개발용 사용자 ID (Bearer 토큰 붙기 전까지 X-User-Id 헤더로 사용)
VITE_DEV_USER_ID=1

# 조회 기준월 (형식: YYYY-MM). 비우면 기본값 2026-09 사용
VITE_BASE_MONTH=2026-09
