# 이 파일을 복사해서 .env 로 저장하세요
#   cp .env.example .env
# .env 는 깃에 올라가지 않습니다.

# 백엔드 API base URL (예: http://localhost:8080/api/v1)
# 비워두면 목데이터 모드로 동작합니다.
VITE_API_BASE_URL=

# 자동 로그인 계정 (로그인 화면이 생기기 전까지 사용하는 개발용 임시 계정)
# 앱 시작 시 POST /auth/login 으로 로그인해 받은 accessToken을
# sessionStorage에 저장하고, API 요청에 Authorization: Bearer 헤더로 붙입니다.
# VITE_API_BASE_URL이 설정되어 있으면 두 값 모두 필수입니다. (비어 있으면 앱이 시작되지 않음)
# VITE_ 변수는 브라우저 번들에 포함되므로 실제 서비스 계정은 넣지 마세요.
VITE_AUTO_LOGIN_EMAIL=
VITE_AUTO_LOGIN_PASSWORD=

# 조회 기준월 (형식: YYYY-MM). 비우면 현재 월 기준으로 조회합니다.
# 시연 데이터를 볼 때는 2026-09 처럼 지정하세요.
VITE_BASE_MONTH=2026-09
